---
import { ctaLink } from '../config.ts';
const { ctaHref } = Astro.props;
const href = ctaHref || ctaLink('index', 'nav');
---
<header class="legal-nav">
  <a href="/" class="brand" aria-label="CashAsIs.com home">
    <img class="brand-logo" src="/images/Cashasis_logo.png" alt="CashAsIs.com — We Buy Houses As-Is" />
  </a>
  <a href={href} class="back">Get a Cash Offer &rarr;</a>
</header>
