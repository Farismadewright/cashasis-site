---
import BaseHead from '../../components/BaseHead.astro';
const entries=[
['net-proceeds','As-Is vs Repair & List Calculator'],
['cost-of-waiting','Cost of Waiting Calculator'],
['seller-situation','Seller Situation Guide'],
['sale-readiness','Cash Sale Readiness Checklist'],
['deadline-organizer','Seller Deadline Organizer']
];
export function getStaticPaths(){return entries.map(([slug,title])=>({params:{slug},props:{title,slug}}));}
const {title,slug}=Astro.props;
---
<!doctype html><html lang="en"><head><BaseHead title={title+' | CashAsIs Review'} description="Private seller-tool preview" /><meta name="robots" content="noindex,nofollow,noarchive"/><link rel="stylesheet" href="/styles.css"/>
<style>body{background:#f2f6f7;color:#18374b;font-family:Inter,Arial,sans-serif}.wrap{max-width:860px;margin:35px auto;padding:16px}.card{background:white;padding:clamp(20px,4vw,38px);border-radius:18px;box-shadow:0 8px 30px #14354a18}h1{font-size:clamp(26px,4vw,38px)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}label{display:block;font-weight:650;margin:10px 0}input,select{display:block;width:100%;box-sizing:border-box;padding:12px;margin-top:5px;border:1px solid #b8cbd0;border-radius:8px;font:inherit}input[type=checkbox]{display:inline;width:auto;margin-right:12px}button,.cta{background:#ef8238;border:0;border-radius:9px;padding:12px 18px;font:inherit;font-weight:750;cursor:pointer;margin:8px 6px 8px 0;display:inline-block;text-decoration:none;color:#15354b}.result{background:#ecf6f5;border-left:4px solid #137e7d;border-radius:8px;padding:16px;margin-top:14px;line-height:1.6}.note{font-size:13px;color:#576d79;line-height:1.6}a{color:#137e7d}li{margin:7px 0}</style></head><body><main class="wrap"><div style="display:flex;justify-content:space-between;align-items:center"><strong style="font-size:24px">cash<span style="color:#ef8238">asis</span></strong><small>PRIVATE REVIEW · NOINDEX</small></div><div class="card"><h1>{title}</h1>
{slug==='net-proceeds'&&<section id="net"><p>Compare two estimated selling scenarios using your own numbers. The as-is price is not a CashAsIs offer.</p><div class="grid">
{[['retail','Expected retail sale price',250000],['asis','Hypothetical as-is sale price',185000],['repairs','Repair budget',30000],['commission','Agent commission %',5],['concessions','Buyer concessions',5000],['closing','Retail closing costs',4500],['cashclosing','As-is seller closing costs',0],['months','Months until retail closing',4],['holding','Monthly holding costs',1500],['payoff','Loans/liens payoff (both)',0]].map(([id,label,value])=><label>{label}<input type="number" id={id} min="0" step={id==='commission'?'0.1':'1'} value={value}/></label>)}</div><button id="calcNet">Compare estimated net</button><div class="result" id="outNet" aria-live="polite"></div><p class="note">Illustrative only, not an appraisal, quote or guaranteed net. Same payoff assumed in both scenarios. Actual title, repairs, taxes, costs and timing may differ.</p></section>}
{slug==='cost-of-waiting'&&<section id="wait"><p>Estimate cash spent carrying a property. Enter monthly costs.</p><div class="grid">{[['mortgage','Mortgage payment',1200],['tax','Property taxes',350],['insurance','Insurance',200],['utilities','Utilities',175],['maintenance','Maintenance',150],['other','Other',0]].map(([id,label,value])=><label>{label}<input type="number" min="0" id={id} value={value}/></label>)}</div><button id="calcWait">Calculate costs</button><div class="result" id="outWait" aria-live="polite"></div><p class="note">Cash outflow only. Mortgage principal may build equity and is not necessarily an economic loss. No forecast of appreciation or future taxes.</p></section>}
{slug==='seller-situation'&&<section><p>Choose your situation for a tailored starting checklist and verified CashAsIs resource.</p><label>What best describes your situation?<select id="situation"><option value="">Choose one</option>{[['inherit','Inherited'],['tax','Behind on taxes'],['foreclosure','Foreclosure'],['tenants','Tenants'],['vacant','Vacant'],['repairs','Major repairs'],['title','Title problem']].map(([value,label])=><option value={value}>{label}</option>)}</select></label><div class="result" id="outSituation" aria-live="polite">Select an issue to see next steps.</div><p class="note">General educational information only; does not establish ownership, rights or legal deadlines.</p></section>}
{slug==='sale-readiness'&&<section id="ready"><p>Check what you already know. Unchecked items become your next-step checklist.</p>{[['Owners and everyone who may need to sign','Confirm owners and required signers'],['Occupancy and any lease','Confirm occupancy, lease and access'],['Mortgage or loan status','Locate loan/payoff information'],['Property tax status','Check current taxes and notices'],['Liens, HOA or title concerns','Identify liens, HOA balances and title concerns'],['Inheritance or probate involvement','Clarify estate/heirship authority if applicable'],['Property access and condition','Arrange access and document condition'],['Preferred closing timeframe','Clarify timing and known deadlines']].map(([label,action])=><label><input type="checkbox" data-action={action}/>{label}</label>)}<button id="calcReady">Build my checklist</button><div class="result" id="outReady" aria-live="polite"></div><p class="note">Organization aid only; not a title review or legal advice.</p></section>}
{slug==='deadline-organizer'&&<section id="deadlines"><p>Enter only known dates from your own plans or actual notices. This tool does not invent or extend legal deadlines.</p><div class="grid">{[['foreclosure','Foreclosure notice/sale'],['taxdate','Tax hearing/deadline'],['auction','Auction'],['tenant','Tenant move-out'],['insurance','Insurance renewal/expiration'],['move','Preferred move/closing']].map(([id,label])=><label>{label}<input type="date" id={id} data-name={label}/></label>)}</div><button id="calcDates">Organize dates</button><button id="printDates">Print</button><div class="result" id="outDates" aria-live="polite"></div><p class="note">No reminders are created. Confirm legal deadlines with the actual notice, responsible agency or attorney. Requesting an offer does not pause a proceeding.</p></section>}
<hr style="margin-top:32px;border:0;border-top:1px solid #dce5e8"/><p><strong>Want to compare this with a possible as-is sale?</strong></p><a class="cta" href={'https://www.cashasis.com/?utm_source=seller_tool&utm_medium=preview&utm_campaign=tool_review&utm_content='+slug}>Get My Cash Offer →</a><p class="note">No obligation. Inputs stay in your browser; these previews do not collect or submit your entries.</p></div></main>
<script is:inline>
const $=id=>document.getElementById(id),money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n),n=id=>{const e=$(id);return e&&e.value.trim()!==''&&Number.isFinite(+e.value)&&+e.value>=0?+e.value:null};
function valid(ids,out){if(ids.some(id=>n(id)===null)){ $(out).textContent='Enter valid nonnegative values in every field.';return false}return true}
if($('calcNet')){const fn=()=>{const ids=['retail','asis','repairs','commission','concessions','closing','cashclosing','months','holding','payoff'];if(!valid(ids,'outNet'))return;if(n('commission')>100){$('outNet').textContent='Commission must be between 0 and 100%.';return}const retail=n('retail')-n('repairs')-n('retail')*n('commission')/100-n('concessions')-n('closing')-n('months')*n('holding')-n('payoff');const cash=n('asis')-n('cashclosing')-n('payoff');$('outNet').textContent='Estimated retail net: '+money(retail)+' | Estimated as-is net: '+money(cash)+' | Difference (as-is minus retail): '+money(cash-retail)};$('calcNet').onclick=fn;fn()}
if($('calcWait')){const fn=()=>{const ids=['mortgage','tax','insurance','utilities','maintenance','other'];if(!valid(ids,'outWait'))return;const total=ids.reduce((a,id)=>a+n(id),0);$('outWait').textContent='Monthly: '+money(total)+' | 30 days: '+money(total)+' | 90 days: '+money(total*3)+' | 6 months: '+money(total*6)};$('calcWait').onclick=fn;fn()}
const situations={inherit:[['Identify recorded owners and possible heirs.','Locate any will or estate documents.','Ask a title/estate professional about required authority and signatures.'],'/blog/sell-inherited-house-before-probate-texas/'],tax:[['Locate the latest property-tax notice.','Check for any suit, judgment or sale date.','Confirm payoff figures with the appropriate professionals.'],'/blog/sell-house-delinquent-property-taxes-texas/'],foreclosure:[['Review your actual notice and dates.','Contact the lender or qualified housing/legal adviser.','Verify whether a sale can close in time.'],'/blog/sell-before-foreclosure-texas/'],tenants:[['Locate the lease and deposit records.','Confirm access and notice requirements.','Review obligations that continue after a sale.'],'/blog/sell-rental-with-tenants-texas/'],vacant:[['Confirm vacancy insurance with your insurer.','Secure access and document condition.','Record monthly holding costs.'],'/blog/vacant-house-insurance-while-selling-houston/'],repairs:[['List known repair issues and safety limits.','Gather photos and access information.','Compare repair-and-list costs against as-is.'],'/blog/sell-house-needs-major-repairs-houston/'],title:[['Identify owners and known claims.','List mortgages, liens, HOA and estate issues.','Ask title professionals what documentation is required.'],'/blog/sell-house-title-problems-houston/']};
if($('situation'))$('situation').onchange=()=>{const d=situations[$('situation').value];$('outSituation').replaceChildren();if(!d){$('outSituation').textContent='Select an issue to see next steps.';return}const ul=document.createElement('ul');d[0].forEach(t=>{const li=document.createElement('li');li.textContent=t;ul.append(li)});const a=document.createElement('a');a.href=d[1];a.textContent='Read related CashAsIs guide →';$('outSituation').append(ul,a)};
if($('calcReady'))$('calcReady').onclick=()=>{const missing=[...document.querySelectorAll('#ready input:not(:checked)')].map(e=>e.dataset.action);$('outReady').replaceChildren();if(!missing.length){$('outReady').textContent='All checklist topics reviewed. A title professional may still request more information.';return}const ul=document.createElement('ul');missing.forEach(t=>{const li=document.createElement('li');li.textContent=t;ul.append(li)});$('outReady').append('Items to confirm:',ul)};
if($('calcDates'))$('calcDates').onclick=()=>{const items=[...document.querySelectorAll('#deadlines input')].filter(e=>e.value).map(e=>({name:e.dataset.name,date:e.value})).sort((a,b)=>a.date.localeCompare(b.date));$('outDates').replaceChildren();if(!items.length){$('outDates').textContent='Enter at least one known date.';return}const ul=document.createElement('ul');items.forEach(x=>{const li=document.createElement('li');li.textContent=x.date+' — '+x.name;ul.append(li)});$('outDates').append('Dates you entered (earliest first):',ul)};
if($('printDates'))$('printDates').onclick=()=>window.print();
</script></body></html>