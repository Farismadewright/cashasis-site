const pubDate=new Date('2026-09-22');
const videoUrl='https://player.vimeo.com/video/1201084786?h=5921c0723f';
const faq=[
 {q:'Can CashAsIs help make the paperwork easier to understand?',a:'CashAsIs works with sellers through the transaction and communicates what is needed as the file moves toward title and closing. Property and title circumstances vary, so required documents depend on the transaction.'},
 {q:'Can a cash property sale move quickly when there is a deadline?',a:'Cash transactions can remove some financing-related steps, but timing still depends on the purchase agreement, title work, required documents, and the circumstances of the property.'},
