---
const benefits = [
  ['No repairs needed','Sell your home in its current condition. No renovations, cleanup, or last-minute projects.'],
  ['No showings','Skip open houses, strangers walking through your home, and weeks of uncertainty.'],
  ['Choose your timeline','We work around your move and your schedule, not the other way around.']
];
const situations = ['Inherited property','Tenant occupied','Major repairs','Behind on taxes','Vacant home','Need to move quickly'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Neighborly Offer | A Simple Way to Sell Your Home</title>
  <meta name="description" content="Get a straightforward cash offer for your home. Sell as-is, skip repairs and showings, and choose a closing timeline that works for you." />
  <style>
    :root{--cyan:#00b4e6;--ink:#111827;--muted:#64748b;--soft:#f5f8fa;--line:#e6edf1;--white:#fff}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff;line-height:1.5} a{text-decoration:none;color:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.nav{height:82px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-size:24px;font-weight:800;letter-spacing:-1px}.mark{width:38px;height:38px;border:5px solid var(--cyan);border-bottom-width:7px;transform:rotate(45deg);border-radius:5px;position:relative}.mark:after{content:'N';position:absolute;transform:rotate(-45deg);font-size:20px;color:var(--ink);font-weight:900;left:7px;top:3px}.brand small{font-size:11px;color:#7b8790;font-weight:700;letter-spacing:2px;margin-left:3px}.navlinks{display:flex;align-items:center;gap:30px;font-size:14px;font-weight:650}.button{display:inline-flex;justify-content:center;align-items:center;border:0;border-radius:10px;background:var(--cyan);color:white;padding:15px 22px;font-weight:800;font-size:15px;cursor:pointer}.button.dark{background:var(--ink)}
    .hero{padding:68px 0 86px;background:linear-gradient(180deg,#fff 0%,#f8fcfd 100%)}.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:72px;align-items:center}.eyebrow{color:#0789ad;font-size:13px;font-weight:850;letter-spacing:1.8px;text-transform:uppercase}.hero h1{font-size:62px;line-height:1.02;letter-spacing:-3.7px;margin:16px 0 20px;max-width:680px}.hero p{font-size:20px;color:#52616d;max-width:580px}.offerbox{margin-top:32px;display:flex;gap:10px;background:#fff;padding:8px;border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 55px rgba(15,35,45,.09);max-width:610px}.offerbox input{flex:1;border:0;outline:0;font-size:16px;padding:13px 15px;min-width:0}.micro{font-size:12px;color:#7c8992;margin-top:11px}.hero-card{background:#eaf8fb;border-radius:28px;min-height:490px;padding:30px;position:relative;overflow:hidden}.house{position:absolute;left:8%;right:8%;bottom:-2%;height:72%;background:#fff;border-radius:20px 20px 0 0;box-shadow:0 25px 60px rgba(30,75,90,.12)}.house:before{content:'';position:absolute;width:66%;height:66%;background:#fff;transform:rotate(45deg);left:17%;top:-31%;border-radius:15px}.door{position:absolute;width:23%;height:47%;background:#c58c61;bottom:0;left:38.5%;border-radius:7px 7px 0 0}.window{position:absolute;width:18%;height:25%;background:#bdebf5;bottom:24%;border:9px solid #25323a}.w1{left:10%}.w2{right:10%}.float{position:absolute;background:#fff;border:1px solid var(--line);box-shadow:0 10px 35px rgba(25,65,80,.1);border-radius:14px;padding:13px 16px;font-size:13px;font-weight:750}.f1{top:30px;right:25px}.f2{bottom:25px;left:25px}.dot{display:inline-block;width:9px;height:9px;background:var(--cyan);border-radius:50%;margin-right:7px}
    .trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.trust-row{display:grid;grid-template-columns:repeat(3,1fr);padding:27px 0}.trust-item{text-align:center;font-weight:750;border-right:1px solid var(--line)}.trust-item:last-child{border:0}.section{padding:100px 0}.center{text-align:center}.section h2{font-size:44px;letter-spacing:-2.2px;line-height:1.1;margin:10px 0 18px}.lead{font-size:18px;color:var(--muted);max-width:680px;margin:0 auto}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:52px}.step{padding:30px;border:1px solid var(--line);border-radius:18px;background:#fff}.num{width:38px;height:38px;border-radius:50%;background:#e5f8fc;color:#058bad;display:grid;place-items:center;font-weight:900}.step h3{font-size:21px;margin:22px 0 9px}.step p{color:var(--muted);margin:0}.soft{background:var(--soft)}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:45px}.benefit{background:#fff;border-radius:18px;padding:30px}.icon{width:44px;height:44px;background:#e6f9fd;border-radius:12px;display:grid;place-items:center;color:#038bad;font-size:21px;font-weight:900}.benefit h3{margin:20px 0 8px}.benefit p{color:var(--muted);margin:0}.situations{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:40px}.pill{padding:12px 17px;border:1px solid var(--line);border-radius:999px;font-weight:700;background:#fff}.quote{max-width:850px;margin:45px auto 0;background:#fff;border:1px solid var(--line);border-radius:22px;padding:40px;font-size:23px;letter-spacing:-.5px}.quote small{display:block;color:var(--muted);font-size:14px;margin-top:18px}.cta{background:var(--ink);color:#fff;border-radius:28px;padding:58px;margin:0 auto 100px;display:grid;grid-template-columns:1fr .85fr;align-items:center;gap:50px}.cta h2{font-size:43px;letter-spacing:-2px;line-height:1.05;margin:0 0 12px}.cta p{color:#b8c3cb;margin:0}.cta .offerbox{margin:0;box-shadow:none}.footer{border-top:1px solid var(--line);padding:38px 0 50px;color:#71808b;font-size:13px}.footer-row{display:flex;justify-content:space-between;gap:30px;align-items:center}
    @media(max-width:800px){.navlinks a:not(.button){display:none}.hero{padding-top:35px}.hero-grid,.cta{grid-template-columns:1fr}.hero h1{font-size:44px;letter-spacing:-2.5px}.hero-card{min-height:360px}.trust-row,.steps,.benefits{grid-template-columns:1fr}.trust-item{border-right:0;border-bottom:1px solid var(--line);padding:13px}.offerbox{flex-direction:column}.section{padding:72px 0}.section h2{font-size:36px}.cta{margin:0 20px 70px;padding:36px 24px}.footer-row{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
<header><div class="wrap nav"><a class="brand" href="/"><span class="mark"></span><span>Neighborly <span style="font-weight:500;color:#66727a">Offer</span><small>.COM</small></span></a><nav class="navlinks"><a href="#how">How it works</a><a href="#why">Why us</a><a href="#faq">FAQ</a><a class="button" href="#offer">Get my offer</a></nav></div></header>
<main>
<section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">A simpler way to sell</div><h1>Sell your home without the usual hassle.</h1><p>Get a straightforward cash offer, sell as-is, and choose a timeline that works for you.</p><form class="offerbox" id="offer" action="#details"><input name="address" required autocomplete="street-address" placeholder="Enter your property address"/><button class="button" type="submit">Get my cash offer</button></form><div class="micro">No obligation · No repairs · No showings</div></div><div class="hero-card" aria-label="Home illustration"><div class="house"><span class="door"></span><span class="window w1"></span><span class="window w2"></span></div><div class="float f1"><span class="dot"></span>Sell as-is</div><div class="float f2"><span class="dot"></span>You choose the closing date</div></div></div></section>
<section class="trust"><div class="wrap trust-row"><div class="trust-item">No repairs or cleanup</div><div class="trust-item">No agent commissions</div><div class="trust-item">Flexible closing timeline</div></div></section>
<section class="section" id="how"><div class="wrap"><div class="center"><div class="eyebrow">How it works</div><h2>Three simple steps. That's it.</h2><p class="lead">Tell us about the property, review your offer, then decide whether it works for you.</p></div><div class="steps"><article class="step"><div class="num">1</div><h3>Tell us about your home</h3><p>Start with the property address and a few basic details. It only takes a few minutes.</p></article><article class="step"><div class="num">2</div><h3>Review your offer</h3><p>Our team reviews the property and walks you through a straightforward cash offer.</p></article><article class="step"><div class="num">3</div><h3>Close on your schedule</h3><p>If the offer works for you, choose a closing timeline that fits your situation.</p></article></div></div></section>
<section class="section soft" id="why"><div class="wrap"><div class="center"><div class="eyebrow">Built around homeowners</div><h2>A home sale that feels easier.</h2><p class="lead">Neighborly Offer is designed for homeowners who value simplicity, certainty, and control.</p></div><div class="benefits">{benefits.map(([title,copy],i)=><article class="benefit"><div class="icon">{['✓','⌂','→'][i]}</div><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
<section class="section"><div class="wrap center"><div class="eyebrow">Whatever brought you here</div><h2>We buy homes in all kinds of situations.</h2><div class="situations">{situations.map(x=><span class="pill">{x}</span>)}</div><div class="quote">“A straightforward conversation, a clear offer, and a timeline that works for you.”<small>That's the Neighborly Offer approach.</small></div></div></section>
<section class="section soft" id="faq"><div class="wrap" style="max-width:850px"><div class="center"><div class="eyebrow">Common questions</div><h2>Know what to expect.</h2></div><div class="steps" style="grid-template-columns:1fr;margin-top:42px"><article class="step"><h3>Do I need to make repairs?</h3><p>No. We evaluate homes in their current condition.</p></article><article class="step"><h3>Am I obligated after requesting an offer?</h3><p>No. Requesting an offer doesn't require you to accept it.</p></article><article class="step"><h3>How quickly can I close?</h3><p>Closing timing depends on the property and title, but we'll work with you to choose a practical timeline.</p></article></div></div></section>
<div class="wrap"><section class="cta"><div><h2>Ready to see what your home could sell for?</h2><p>Start with your property address. There's no obligation.</p></div><form class="offerbox" action="#details"><input name="address" required autocomplete="street-address" placeholder="Enter your property address"/><button class="button" type="submit">Get started</button></form></section></div>
</main>
<footer class="footer"><div class="wrap footer-row"><div class="brand" style="font-size:18px"><span class="mark" style="width:28px;height:28px;border-width:4px"></span><span>Neighborly Offer</span></div><div>© 2026 Neighborly Offer. All rights reserved.</div><div>Privacy · Terms</div></div></footer>
</body></html>