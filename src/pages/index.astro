---
const benefits = [
  ['No repairs needed','Sell your home as-is. No renovations, cleanup, or last-minute projects.'],
  ['No showings','Skip open houses, strangers walking through your home, and weeks of uncertainty.'],
  ['Local buyer insight','Work with a local team that understands the area and neighborhood dynamics.'],
  ['Choose your timeline','We work around your move and your schedule, not the other way around.']
];
const situations = ['Inherited property','Tenant occupied','Major repairs','Behind on taxes','Vacant home','Need to move quickly'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Neighborly Offer | Sell for Cash Locally</title>
  <meta name="description" content="Sell your home for cash to a local buyer who knows the area. No repairs, no showings, no obligation." />
  <style>
    :root{--cyan:#12b7e6;--teal:#0ca39a;--navy:#10253d;--ink:#14202f;--muted:#677383;--cream:#fbfaf6;--soft:#f2f7f8;--line:#e3eaee;--white:#fff}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--cream);line-height:1.5} a{text-decoration:none;color:inherit}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}.nav{height:82px;display:flex;align-items:center;justify-content:space-between}.logo{display:flex;align-items:flex-end;gap:10px;font-weight:900;letter-spacing:-1.5px;font-size:24px}.logo-house{width:18px;height:18px;background:var(--cyan);clip-path:polygon(50% 0,100% 42%,100% 100%,0 100%,0 42%)}.logo-sub{font-size:10px;letter-spacing:4px;color:#7e8793;font-weight:700;margin-left:3px}.navlinks{display:flex;align-items:center;gap:28px;font-size:14px;font-weight:650}.btn{display:inline-flex;align-items:center;justify-content:center;border:none;border-radius:8px;padding:14px 20px;background:var(--navy);color:#fff;font-weight:800;cursor:pointer}.btn.cyan{background:var(--cyan)}
    .hero{padding:58px 0 78px;background:linear-gradient(180deg,#fff 0%,#f8fbfb 100%)}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}.kicker{font-size:12px;text-transform:uppercase;letter-spacing:2.4px;font-weight:800;color:#607284}.hero h1{font-family:Georgia,serif;font-size:64px;line-height:1.02;letter-spacing:-2.5px;margin:14px 0 18px;max-width:700px}.hero p{font-size:19px;color:#4f5f70;max-width:610px}.offerbox{margin-top:28px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 14px 40px rgba(24,47,63,.08);padding:10px;max-width:650px}.tabs{display:flex;border-bottom:1px solid var(--line);margin:-10px -10px 10px}.tab{padding:13px 22px;font-weight:800;color:#61707b}.tab.active{background:var(--navy);color:#fff;border-radius:12px 12px 0 0}.formrow{display:flex;gap:10px}.formrow input{flex:1;border:1px solid var(--line);border-radius:8px;padding:15px;font-size:16px}.micro{font-size:12px;color:#7e8793;margin-top:10px}.icons{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}.iconitem{font-size:13px;color:#556372}.iconitem strong{display:block;color:var(--ink);margin-top:6px}.hero-visual{position:relative;min-height:500px}.blob{position:absolute;inset:30px 10px 20px 30px;background:linear-gradient(135deg,#bff3f7,#8ddcf2);border-radius:42% 58% 52% 48%/42% 44% 56% 58%;transform:rotate(-3deg)}.home-photo{position:absolute;inset:55px 0 45px 55px;background:url('/images/cash-offer-vs-listing-house-houston.jpg') center/cover;border-radius:44% 56% 50% 50%/42% 45% 55% 58%;box-shadow:0 30px 70px rgba(32,56,76,.18)}.sold{position:absolute;right:10px;bottom:36px;background:#fff;padding:14px 18px;border-radius:14px;box-shadow:0 10px 30px rgba(20,38,52,.12);font-size:13px;font-weight:800}.scribble{position:absolute;right:15px;top:6px;font-family:cursive;font-size:24px;color:#2f3d4a;transform:rotate(-5deg)}
    .press{padding:25px 0 34px;background:#f5f3ee;border-top:1px solid #efede7}.press-row{display:flex;justify-content:center;gap:70px;flex-wrap:wrap;font-family:Georgia,serif;font-weight:800;color:#4b5563;font-size:24px}.wave{height:36px;background:var(--navy);clip-path:ellipse(58% 100% at 50% 100%)}
    .dark{background:var(--navy);color:#fff;padding:76px 0 90px}.dark h2,.section h2{font-family:Georgia,serif;font-size:46px;line-height:1.08;letter-spacing:-1.4px;margin:10px 0 16px}.center{text-align:center}.dark .lead{color:#c8d2db}.benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:34px;margin-top:46px}.benefit{text-align:center}.benefit-icon{font-size:28px;color:#66e1f4}.benefit h3{color:#81e5f5;font-size:18px;margin:16px 0 8px}.benefit p{color:#d8e1e8;font-size:14px}
    .section{padding:86px 0}.lead{color:var(--muted);font-size:18px}.agents{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:35px}.agent{background:#c7f5f7;border-radius:12px;overflow:hidden;aspect-ratio:.82;position:relative}.agent img{width:100%;height:100%;object-fit:cover}.agent span{position:absolute;right:8px;bottom:14px;background:#fff;border-radius:8px;padding:6px 8px;font-size:11px;font-weight:800}.split{display:grid;grid-template-columns:1fr 1.15fr;gap:40px;align-items:start;margin-top:42px}.review{padding:25px 10px;text-align:center}.review .quote{font-family:Georgia,serif;font-size:30px;line-height:1.15}.stars{letter-spacing:5px;margin:14px 0}.compare{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden}.compare h3{font-family:Georgia,serif;font-size:30px;text-align:center;margin:24px 0 8px}.row{display:grid;grid-template-columns:1fr 1.4fr 1fr;padding:14px 18px;border-top:1px solid #edf1f3;align-items:center;font-size:14px}.row.head{background:var(--navy);color:#fff;font-weight:800}.yes{color:#0a9d8a;font-weight:900}.no{color:#f0534b;font-weight:900}.resources{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:28px}.resource{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}.resource img{width:100%;aspect-ratio:1.8;object-fit:cover}.resource div{padding:14px}.resource strong{display:block;margin-bottom:4px}.cities{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.city{border:1px solid #aeb8c0;border-radius:999px;padding:7px 12px;font-size:12px;background:#fff}.footer{background:var(--navy);color:#d8e1e8;padding:48px 0 24px}.footergrid{display:grid;grid-template-columns:1.3fr repeat(3,1fr) 1.4fr;gap:32px}.footer h4{color:#fff;margin:0 0 12px}.footer a{display:block;font-size:13px;margin:7px 0}.email{display:flex;background:#fff;border-radius:8px;overflow:hidden}.email input{border:0;flex:1;padding:12px}.email button{border:0;background:var(--teal);color:#fff;width:48px}.copyright{border-top:1px solid rgba(255,255,255,.14);margin-top:32px;padding-top:18px;font-size:12px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
    @media(max-width:900px){.navlinks a:not(.btn){display:none}.hero-grid,.split,.footergrid{grid-template-columns:1fr}.hero h1{font-size:46px}.hero-visual{min-height:390px}.benefits{grid-template-columns:1fr 1fr}.agents{grid-template-columns:1fr 1fr}.resources{grid-template-columns:1fr 1fr}.press-row{gap:30px;font-size:20px}} @media(max-width:600px){.formrow{flex-direction:column}.icons,.benefits,.agents,.resources{grid-template-columns:1fr}.hero h1{font-size:40px}.section h2,.dark h2{font-size:36px}.row{grid-template-columns:.8fr 1.4fr .8fr;font-size:12px}.hero-visual{min-height:330px}}
  </style>
</head>
<body>
<header><div class="wrap nav"><a class="logo" href="/"><span>Neighborly</span><span class="logo-house"></span><span class="logo-sub">OFFER.COM</span></a><nav class="navlinks"><a href="#how">How it works</a><a href="#reviews">Reviews</a><a href="#faq">FAQ</a><a href="#resources">Resources</a><a href="#">Log in</a><a class="btn" href="#offer">Get Started</a></nav></div></header>
<main>
<section class="hero"><div class="wrap hero-grid"><div><div class="kicker">A better way to sell your home</div><h1>Sell for Cash local to a neighbor that knows the area</h1><p>Sell as-is to a local buyer who understands your neighborhood, your market, and your situation — without repairs, showings, or the usual stress.</p><div class="offerbox" id="offer"><div class="tabs"><div class="tab active">Sell for Cash</div><div class="tab">Sell a home</div><div class="tab">Learn more</div></div><div class="formrow"><input placeholder="Enter your current address..." /><button class="btn cyan">Get my free valuation →</button></div><div class="micro">No obligation · Results in minutes</div></div><div class="icons"><div class="iconitem">⌂<strong>Local buyer insight</strong></div><div class="iconitem">$<strong>No repairs needed</strong></div><div class="iconitem">♥<strong>A neighborly process</strong></div></div></div><div class="hero-visual"><div class="blob"></div><div class="home-photo"></div><div class="scribble">Move forward<br/>with what’s next.</div><div class="sold">● Sold with Neighborly Offer<br/><span style="font-weight:500;color:#6b7280">Houston, TX</span></div></div></div></section>
<section class="press"><div class="wrap press-row"><span>Forbes</span><span>The Wall Street Journal</span><span>Fortune</span><span>Yahoo! Finance</span><span>CNBC</span></div></section><div class="wave"></div>
<section class="dark" id="how"><div class="wrap center"><div class="kicker" style="color:#8ca7b6">A smarter way for a brighter next chapter</div><h2>Stress-free solutions to sell your home.</h2><div class="benefits">{benefits.map(([title,copy],i)=><article class="benefit"><div class="benefit-icon">{['⌂','◈','▥','◫'][i]}</div><h3>{title}</h3><p>{copy}</p></article>)}</div><a class="btn" style="margin-top:34px;border:1px solid #fff;background:transparent" href="#offer">Get started with a free home valuation</a></div></section>
<section class="section"><div class="wrap"><div class="kicker">Meet the Neighborly team</div><h2>Local people. Real results.</h2><p class="lead">A professional local experience built around homeowners who want a simpler cash sale.</p><div class="agents"><div class="agent"><img src="/images/apple-touch-icon.png" alt=""><span>Local expertise</span></div><div class="agent"><img src="/images/cash-offer-vs-listing-house-detroit.jpg" alt=""><span>Fast answers</span></div><div class="agent"><img src="/images/inherited-house-probate-detroit.jpg" alt=""><span>Sell as-is</span></div><div class="agent"><img src="/images/sell-flood-damaged-house-houston.jpg" alt=""><span>Flexible closing</span></div><div class="agent"><img src="/images/sell-fire-damaged-house-detroit.jpg" alt=""><span>Cash offer</span></div></div><div class="split" id="reviews"><div class="review"><div style="font-weight:800;color:#06a06f">★ Trustpilot</div><div class="quote">“Straightforward process, clear communication, and no pressure.”</div><div class="stars">★★★★★</div><div style="color:#667085">Homeowner · Houston, TX</div></div><div class="compare"><h3>There’s No Comparison</h3><div class="row head"><div>Neighborly Offer</div><div></div><div>Traditional Sale</div></div>{['No repairs needed','No showings','Flexible closing date','No agent commissions','Direct local buyer'].map(x=><div class="row"><div class="yes">✓</div><div>{x}</div><div class="no">✕</div></div>)}</div></div></div></section>
<section class="section" id="resources" style="padding-top:30px"><div class="wrap"><h2 style="font-size:38px">Resources and Calculators</h2><p class="lead">Helpful tools and guides for homeowners considering a sale.</p><div class="resources"><article class="resource"><img src="/images/cash-offer-vs-listing-house-houston.jpg"><div><strong>Cash Offer vs. Listing</strong><span>View guide →</span></div></article><article class="resource"><img src="/images/inherited-house-probate-detroit.jpg"><div><strong>Inherited Property Guide</strong><span>View guide →</span></div></article><article class="resource"><img src="/images/sell-flood-damaged-house-houston.jpg"><div><strong>Selling a Distressed Home</strong><span>View guide →</span></div></article><article class="resource"><img src="/images/sell-fire-damaged-house-detroit.jpg"><div><strong>Market Reports</strong><span>View reports →</span></div></article></div><h3 style="font-family:Georgia,serif;font-size:28px;margin-top:38px">Areas we serve</h3><div class="cities">{['Houston, TX','Dallas-Fort Worth, TX','Austin, TX','San Antonio, TX','Detroit, MI','Phoenix, AZ','Orlando, FL','Tampa Bay, FL'].map(c=><span class="city">{c}</span>)}</div></div></section>
</main>
<footer class="footer"><div class="wrap"><div class="footergrid"><div><div class="logo" style="color:#fff"><span>Neighborly</span><span class="logo-house"></span><span class="logo-sub" style="color:#aeb9c4">OFFER.COM</span></div><p style="font-size:13px;color:#aeb9c4">A simpler local way to sell your home for cash.</p></div><div><h4>About</h4><a>About Us</a><a>Reviews</a><a>Careers</a></div><div><h4>Our Services</h4><a>Sell for Cash</a><a>How It Works</a><a>Cash Offer</a></div><div><h4>Resources</h4><a>Blog</a><a>Market Reports</a><a>FAQ</a></div><div><h4>Stay in the loop</h4><p style="font-size:13px;color:#aeb9c4">Get market insights and home tips.</p><div class="email"><input placeholder="Enter your email"><button>→</button></div></div></div><div class="copyright"><span>© 2026 Neighborly Offer. All rights reserved.</span><span>Terms · Privacy · Accessibility</span></div></div></footer>
</body></html>