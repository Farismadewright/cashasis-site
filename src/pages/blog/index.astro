---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ctaLink } from '../../config.ts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d) => new Date(d).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
const rest = posts;
const indexCta = ctaLink('blog-index', 'index');
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Houston Home Selling Guide | CashAsIs Blog"
    description="Straight-talk guides on selling your Houston house fast: inherited homes, foreclosure, flood damage, probate, tired landlords and more. Real answers, no fluff."
  />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <Nav ctaHref={indexCta} />
  <section class="legal-hero">
    <div class="in">
      <span class="badge">Blog &amp; Resources</span>
      <h1>Straight Talk for Home Sellers</h1>
      <p class="meta">Real answers for homeowners who need to sell. No jargon, no fluff, no pressure.</p>
    </div>
  </section>

  <main class="legal-wrap wide">
    <a class="featured" href="/after-you-sign/">
      <div class="featured-thumb">
        <img class="thumb-img" src="/images/what-happens-after-you-sign.jpg.png" alt="What happens after you sign a cash home sale agreement — CashAsIs seller guide" width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="featured-body">
        <span class="fcat">NEW SELLER GUIDE</span>
        <h2>What Happens After You Sign a Cash Home Sale Agreement?</h2>
        <p>From signing to title to closing: see the four simple steps that happen next, plus answers about repairs, cleanout, timing, and getting paid.</p>
        <span class="read">Read &rarr;</span>
      </div>
    </a>

    <div class="post-grid">
      <a class="post-card" href="/seller-stories/straightforward-cash-sale/">
        <div class="post-thumb">
          <img class="thumb-img" src="/images/straightforward-cash-sale%20testimony.png" alt="CashAsIs seller story — straightforward cash sale and paperwork help when time mattered" width="1200" height="630" loading="lazy" decoding="async" />
          <span class="post-cat">Seller Story</span>
        </div>
        <div class="post-body">
          <h3>A Straightforward Cash Sale When Time Mattered</h3>
          <p>Watch a real seller describe an all-cash, transparent process and getting the paperwork handled quickly.</p>
          <div class="post-foot"><span>1 min watch</span><span class="read">Watch &rarr;</span></div>
        </div>
      </a>
      <a class="post-card" href="/why-sell-as-is/">
        <div class="post-thumb">
          <img class="thumb-img" src="/images/Selling%20a%20Property%20As-Is.png" alt="What selling a property as-is means — repairs, cleanup, maintenance and showings" width="1200" height="630" loading="lazy" decoding="async" />
          <span class="post-cat">As-Is Selling</span>
        </div>
        <div class="post-body">
          <h3>What Does Selling a Property As-Is Really Mean?</h3>
          <p>No repairs, cleanup, maintenance, or showings first. Learn what an as-is sale can remove from your property to-do list.</p>
          <div class="post-foot"><span>5 min read</span><span class="read">Read &rarr;</span></div>
        </div>
      </a>
      <a class="post-card" href="/seller-stories/sold-fast/">
        <div class="post-thumb">
          <img class="thumb-img" src="/images/Fast%20Closing%20Testimonial.png" alt="CashAsIs real seller story — sold fast and closed in record time" width="1200" height="630" loading="lazy" decoding="async" />
          <span class="post-cat">Seller Story</span>
        </div>
        <div class="post-body">
          <h3>Seller Story: Sold Fast and Closed in Record Time</h3>
          <p>Watch a real CashAsIs seller share her experience and see what moving from agreement to closing can look like.</p>
          <div class="post-foot"><span>1 min watch</span><span class="read">Watch &rarr;</span></div>
        </div>
      </a>
      {rest.map((post) => (
        <a class="post-card" href={`/blog/${post.slug}/`}>
          <div class="post-thumb">
            {post.data.image && <img class="thumb-img" src={post.data.image} alt={post.data.imageAlt || post.data.title} width="1200" height="630" loading="lazy" decoding="async" />}
            <span class="post-cat">{post.data.category || 'Seller Guide'}</span>
          </div>
          <div class="post-body">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-foot">
              <span>{post.data.readTime || fmt(post.data.pubDate)}</span>
              <span class="read">Read &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="callout" style="margin-top:38px">
      <p><b>Ready for a real number?</b> Get a no-obligation cash offer on your Houston house &mdash; any condition, any situation. No repairs, no fees, no pressure.</p>
      <a href={indexCta} class="cbtn">Get My Cash Offer <span>&rarr;</span></a>
    </div>
  </main>

  <Footer />
  <!-- HighLevel External Tracking: documented placement before closing body -->
  <script is:inline src="https://link.msgsndr.com/js/external-tracking.js" data-tracking-id="tk_61336d42285a45a29bdc44b9a0947ddf"></script>
</body>
</html>
