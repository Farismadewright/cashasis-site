---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ctaLink } from '../../config.ts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d) => new Date(d).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
const curatedSlugs = new Set(['sell-vacant-property-as-is-no-repairs','dont-live-in-area-vacant-property-risk','empty-house-problems-dont-wait','still-paying-unused-property','inherited-property-not-the-problems','inherited-property-leave-belongings-as-is','multiple-heirs-inherited-property-cashasis','skip-full-probate-affidavit-heirship-cashasis','inherited-property-cashasis-options','dont-let-back-taxes-take-property','what-happens-back-taxes-when-you-sell','sell-property-with-back-taxes','delinquent-property-taxes-tax-suit-sale','sell-property-with-delinquent-taxes','dont-wait-to-sell-before-foreclosure','options-before-foreclosure-sale','act-early-before-foreclosure','understanding-your-pre-foreclosure-timeline','sell-before-foreclosure-sale']);
const rest = posts.filter((post) => !curatedSlugs.has(post.slug));
const indexCta = ctaLink('blog-index', 'index');
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Houston Home Selling Guide | CashAsIs Blog"
    description="Straight-talk guides on selling your Houston house fast: inherited homes, foreclosure, flood damage, probate, tired landlords and more. Real answers, no fluff."
  />
  <link rel="stylesheet" href="/styles.css" />
<style>.post-thumb .offer-thumb-fit{object-fit:contain;object-position:center;background:#fff;padding:0;}</style></head>
<body>
  <Nav ctaHref={indexCta} />
  <section class="legal-hero">
    <div class="in">
      <span class="badge">Blog &amp; Resources</span>
      <h1>Straight Talk for Home Sellers</h1>
      <p class="meta">Real answers for homeowners who need to sell. No jargon, no fluff, no pressure.</p>
    </div>
  </section>

  <main class="legal-wrap wide">
    <a class="featured" href="/after-you-sign/">
      <div class="featured-thumb">
        <img class="thumb-img" src="/images/what-happens-after-you-sign.jpg.png" alt="What happens after you sign a cash home sale agreement — CashAsIs seller guide" width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="featured-body">
        <span class="fcat">NEW SELLER GUIDE</span>
