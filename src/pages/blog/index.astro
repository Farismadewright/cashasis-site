---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ctaLink } from '../../config.ts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d) => new Date(d).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
const legacyAstroSlugs = new Set(['act-early-before-foreclosure','understanding-your-pre-foreclosure-timeline','sell-before-foreclosure-sale']);
const rest = posts.filter((post) => !legacyAstroSlugs.has(post.slug));
const indexCta = ctaLink('blog-index', 'index');
---
<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title="Houston Home Selling Guide | CashAsIs Blog"
    description="Straight-talk guides on selling your Houston house fast: inherited homes, foreclosure, flood damage, probate, tired landlords and more. Real answers, no fluff."
  />
  <link rel="stylesheet" href="/styles.css" />
<style>.post-thumb .offer-thumb-fit{object-fit:contain;object-position:center;background:#fff;padding:0;}</style></head>
<body>
  <Nav ctaHref={indexCta} />
  <section class="legal-hero">
    <div class="in">
      <span class="badge">Blog &amp; Resources</span>
      <h1>Straight Talk for Home Sellers</h1>
      <p class="meta">Real answers for homeowners who need to sell. No jargon, no fluff, no pressure.</p>
    </div>
  </section>

  <main class="legal-wrap wide">
    <a class="featured" href="/after-you-sign/">
      <div class="featured-thumb">
        <img class="thumb-img" src="/images/what-happens-after-you-sign.jpg.png" alt="What happens after you sign a cash home sale agreement — CashAsIs seller guide" width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="featured-body">
        <span class="fcat">NEW SELLER GUIDE</span>
        <h2>What Happens After You Sign a Cash Home Sale Agreement?</h2>
        <p>From signing to title to closing: see the four simple steps that happen next, plus answers about repairs, cleanout, timing, and getting paid.</p>
        <span class="read">Read &rarr;</span>
      </div>
    </a>

    <div class="post-grid">
      <a class="post-card" href="/blog/sell-before-foreclosure-sale/">
        <div class="post-thumb"><span class="post-cat">Pre-Foreclosure</span></div>
        <div class="post-body"><h3>Can You Sell Your Property Before a Foreclosure Sale?</h3><p>Yes, you may be able to sell before foreclosure. Learn why enough time for an offer, title, mortgage payoff, and closing matters.</p><div class="post-foot"><span>4 min read</span><span class="read">Read &rarr;</span></div></div>
      </a>
      <a class="post-card" href="/blog/act-early-before-foreclosure/">
        <div class="post-thumb"><img class="thumb-img" src="/images/act-early-before-foreclosure-cashasis.png.png" alt="Act early before foreclosure — more time means more options" width="1200" height="630" loading="eager" decoding="async" /><span class="post-cat">Pre-Foreclosure</span></div>
        <div class="post-body"><h3>Act Early: More Time Means More Options Before Foreclosure</h3><p>Why starting earlier leaves more room to review an offer, handle title and payoff, and complete a sale before the deadline.</p><div class="post-foot"><span>3 min read</span><span class="read">Read &rarr;</span></div></div>
      </a>
      <a class="post-card" href="/blog/understanding-your-pre-foreclosure-timeline/">
        <div class="post-thumb"><img class="thumb-img" src="/images/pre-foreclosure-timeline-cashasis.png.png" alt="Pre-foreclosure timeline — know your date and options before the sale" width="1200" height="630" loading="eager" decoding="async" /><span class="post-cat">Pre-Foreclosure</span></div>
        <div class="post-body"><h3>Understanding Your Pre-Foreclosure Timeline</h3><p>If you are considering selling before foreclosure, confirm your sale date early so there is time to review an offer, title, payoff, and closing.</p><div class="post-foot"><span>3 min read</span><span class="read">Read &rarr;</span></div></div>
      </a>
      {rest.map((post) => (
        <a class="post-card" href={`/blog/${post.slug}/`}>
          <div class="post-thumb">
            {post.data.image && <img class="thumb-img" src={post.data.image} alt={post.data.imageAlt || post.data.title} width="1200" height="630" loading="lazy" decoding="async" />}
            <span class="post-cat">{post.data.category || 'Seller Guide'}</span>
          </div>
          <div class="post-body">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-foot">
              <span>{post.data.readTime || fmt(post.data.pubDate)}</span>
              <span class="read">Read &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="callout" style="margin-top:38px">
      <p><b>Ready for a real number?</b> Get a no-obligation cash offer on your Houston house &mdash; any condition, any situation. No repairs, no fees, no pressure.</p>
      <a href={indexCta} class="cbtn">Get My Cash Offer <span>&rarr;</span></a>
    </div>
  </main>

  <Footer />
  <!-- HighLevel External Tracking: documented placement before closing body -->
  <script is:inline src="https://link.msgsndr.com/js/external-tracking.js" data-tracking-id="tk_61336d42285a45a29bdc44b9a0947ddf"></script>
</body>
</html>
