---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const title='Fix It or Sell It? Houston Repair Cost Calculator | CashAsIs';
const description='Estimate retail Houston repair costs before fixing a property for sale. Compare roof, HVAC, foundation, kitchen, bath, plumbing, electrical and paint costs.';
const faq=[
 {q:'Where do these repair estimates come from?',a:'The planning estimates use current Houston-area contractor and consumer cost data. Actual costs vary by property, materials, scope, permits, access and hidden conditions.'},
 {q:'Is this a contractor quote?',a:'No. It is an educational planning tool. Actual bids vary by property, scope, materials, permits, access and hidden conditions.'},
 {q:'Do I need to make these repairs before CashAsIs will evaluate my property?',a:'No. CashAsIs evaluates properties as-is. The calculator is designed to help owners understand the potential retail repair burden before deciding what to do.'}
];
---
<!doctype html><html lang="en"><head>
<BaseHead title={title} description={description} type="website" faq={faq}/>
<link rel="stylesheet" href="/styles.css"/>
<style>
.rm-wrap{max-width:1080px;margin:0 auto;padding:34px 24px 60px}.rm-intro{max-width:800px;margin:0 auto 28px;text-align:center;color:#536173}.rm-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:start}.rm-panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px;box-shadow:0 18px 44px -34px rgba(13,27,42,.5)}.rm-panel h2{margin:0 0 8px;font-size:22px}.rm-panel .hint{font-size:13px;color:#687586;margin-bottom:20px}.rm-q{border-top:1px solid var(--line);padding:18px 0}.rm-q:first-of-type{border-top:0}.rm-q label.title{display:block;font-weight:800;margin-bottom:10px}.rm-choice{display:flex;gap:10px;flex-wrap:wrap}.rm-choice label{border:1px solid #d9dee6;border-radius:999px;padding:9px 14px;font-size:14px;font-weight:700;cursor:pointer}.rm-choice input{margin-right:6px}.repairs{display:grid;gap:10px}.repair{border:1px solid #e1e5eb;border-radius:12px;padding:14px;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center}.repair input{width:20px;height:20px}.repair b{display:block}.repair small{display:block;color:#6b7787}.repair .src{display:inline-block;margin-top:5px;font-size:12px;font-weight:800;color:var(--teal);text-decoration:underline}.repair .src:hover{text-decoration:none}.repair .range{font-weight:800;white-space:nowrap}.scope{display:none;margin:-4px 0 10px 32px}.scope.show{display:block}.scope select{width:100%;padding:10px;border:1px solid #d9dee6;border-radius:9px;background:#fff;font:inherit}.rm-result{position:sticky;top:86px}.total{font-size:clamp(34px,5vw,50px);font-weight:900;letter-spacing:-.04em;color:var(--navy);line-height:1.05;margin:12px 0}.total span{color:var(--orange)}.rm-note{font-size:13px;color:#697586;line-height:1.55}.rm-breakdown{margin:20px 0;border-top:1px solid var(--line);padding-top:14px}.rm-row{display:flex;justify-content:space-between;gap:16px;padding:8px 0;font-size:14px}.rm-row strong{white-space:nowrap}.rm-cta{background:var(--navy);color:#fff;border-radius:14px;padding:20px;margin-top:18px}.rm-cta p{color:#e7edf4;margin-bottom:14px}.rm-btn{display:inline-flex;background:var(--orange);color:#fff;font-weight:800;border-radius:999px;padding:13px 20px}.sources{margin-top:30px}.sources h2{margin-bottom:10px}.sources li{margin:8px 0;color:#536173}.sources a{color:var(--teal);text-decoration:underline}.privacy{background:#f4f7fa;border-radius:12px;padding:14px;margin-top:18px;font-size:13px;color:#596678}@media(max-width:800px){.rm-grid{grid-template-columns:1fr}.rm-result{position:static}.repair{grid-template-columns:auto 1fr}.repair .range{grid-column:2}}
</style>
</head><body>
<Nav/>
<section class="legal-hero"><div class="in"><span class="badge">Houston Repair Math</span><h1>Fix It or Sell It?</h1><p class="meta">See what retail homeowner repairs can cost before you spend a dollar preparing a property for market.</p></div></section>
<main class="rm-wrap">
<p class="rm-intro"><strong>See what common repairs could cost before you put more money into your property.</strong> Enter the approximate house size, select the work it may need, and get a practical Houston-area repair estimate. Then compare the cost of fixing it first with the option of selling the property as-is.</p>
<div class="rm-grid">
<section class="rm-panel">
<h2>Build your repair list</h2><p class="hint">Enter the property's approximate living area, then choose the work you believe it needs. The calculator returns one estimated retail repair budget instead of a giant range.</p>
<div class="rm-q"><label class="title" for="sqft">Approximate house size (living area)</label><input id="sqft" type="number" min="400" max="10000" step="50" value="1800" inputmode="numeric" style="width:100%;padding:12px;border:1px solid #d9dee6;border-radius:10px;font:inherit"><p class="hint" style="margin:7px 0 0">Use approximate heated/living square feet. We use this where size actually drives the retail job cost.</p></div>
<div class="rm-q"><label class="title">Has the property been substantially updated in the last 5 years?</label><div class="rm-choice"><label><input type="radio" name="updated" value="yes">Yes</label><label><input type="radio" name="updated" value="some" checked>Some updates</label><label><input type="radio" name="updated" value="no">No</label></div></div>
<div class="rm-q"><label class="title" for="condition">How would you describe the property overall?</label><select id="condition" style="width:100%;padding:12px;border:1px solid #d9dee6;border-radius:10px;font:inherit"><option value="1">Mostly maintained</option><option value="1.08" selected>Outdated / deferred maintenance</option><option value="1.18">Significant deferred maintenance</option></select></div>
<div class="rm-q"><label class="title">What may need work?</label>
<div class="repairs" id="repairs">
<label class="repair"><input type="checkbox" data-name="Roof replacement" data-method="sf" data-rate="7.00"><span><b>Roof replacement</b><small>Retail installed asphalt-shingle planning allowance based on house size + roof-area factor</small><a class="src" href="https://www.angi.com/articles/how-much-does-roof-replacement-cost/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">$7.00 / roof sf</span></label>
<label class="repair"><input type="checkbox" data-name="Interior painting" data-method="sf" data-rate="3.25"><span><b>Interior painting</b><small>Walls/ceilings/trim contractor-grade repaint allowance</small><a class="src" href="https://houstonsuperiorpainting.com/houston-painting-cost-guide" target="_blank" rel="noopener">Source: Houston Superior Painting 2026 ↗</a></span><span class="range">$3.25 / living sf</span></label>
<label class="repair"><input type="checkbox" data-name="Flooring replacement" data-method="sf" data-rate="7.00"><span><b>Flooring replacement</b><small>Retail installed mid-grade LVP/carpet blend planning allowance</small><a class="src" href="https://www.angi.com/articles/how-much-should-my-new-floor-cost/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">$7.00 / living sf</span></label>
<label class="repair"><input type="checkbox" data-name="HVAC replacement" data-method="hvac"><span><b>HVAC replacement</b><small>Complete retail installed system; choose standard replacement or system + substantial ductwork</small><a class="src" href="https://www.angi.com/articles/insider-s-price-guide-new-heating-and-cooling-system/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">Choose scope</span></label><div class="scope" data-for="HVAC replacement"><select data-scope="HVAC replacement"><option value="10500" selected>Complete system replacement</option><option value="15000">System + substantial ductwork</option></select></div>
<label class="repair"><input type="checkbox" data-name="Whole-home repipe" data-method="repipe"><span><b>Whole-home repipe</b><small>Retail whole-house plumbing allowance scaled to living area</small><a class="src" href="https://texasqualityplumbing.com/learning-center/repiping-house-cost-houston" target="_blank" rel="noopener">Source: Texas Quality Plumbing 2026 ↗</a></span><span class="range">Size-based</span></label>
<label class="repair"><input type="checkbox" data-name="Electrical / panel & wiring" data-method="electrical"><span><b>Electrical / Panel & Wiring</b><small>Choose panel/service only or include meaningful wiring corrections and runs</small><a class="src" href="https://www.angi.com/articles/ask-angie-what-does-it-cost-upgrade-200-amps/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">Choose scope</span></label><div class="scope" data-for="Electrical / panel & wiring"><select data-scope="Electrical / panel & wiring"><option value="5000">Panel / service upgrade</option><option value="8500" selected>Panel + some wiring</option><option value="15000">Major electrical updating</option></select></div>
<label class="repair"><input type="checkbox" data-name="Foundation repair" data-method="foundation"><span><b>Foundation repair</b><small>Planning allowance based on repair scope—not house square footage</small><a class="src" href="https://htxfoundations.com/blog/how-much-foundation-repair-cost-houston/" target="_blank" rel="noopener">Source: HTX Foundation Repair 2026 ↗</a></span><span class="range">Choose scope</span></label>
<div class="scope" data-for="Foundation repair"><select data-scope="Foundation repair"><option value="6500">Minor / localized</option><option value="12000" selected>Moderate repair</option><option value="22000">Extensive repair</option></select></div>
<label class="repair"><input type="checkbox" data-name="Kitchen update" data-method="kitchen"><span><b>Kitchen</b><small>Choose cosmetic, moderate, or full contractor-grade work</small><a class="src" href="https://skyprohouston.com/remodeling-cost-houston/" target="_blank" rel="noopener">Source: Sky Pro Houston ↗</a></span><span class="range">Choose scope</span></label>
<div class="scope" data-for="Kitchen update"><select data-scope="Kitchen update"><option value="10000">Cosmetic refresh</option><option value="19000" selected>Moderate update</option><option value="32000">Full contractor-grade replacement</option></select></div>
<label class="repair"><input type="checkbox" data-name="Bathroom updates" data-method="bath"><span><b>Bathrooms</b><small>Retail contractor allowance per bathroom selected</small><a class="src" href="https://skyprohouston.com/remodeling-cost-houston/" target="_blank" rel="noopener">Source: Sky Pro Houston ↗</a></span><span class="range">Count + scope</span></label>
<div class="scope" data-for="Bathroom updates"><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><select id="bathCount"><option value="1">1 bathroom</option><option value="2" selected>2 bathrooms</option><option value="3">3 bathrooms</option><option value="4">4 bathrooms</option></select><select id="bathScope"><option value="7000">Basic update</option><option value="12000" selected>Moderate remodel</option><option value="18000">Full contractor-grade remodel</option></select></div></div>
<label class="repair"><input type="checkbox" data-name="Exterior painting" data-method="sf" data-rate="3.00"><span><b>Exterior painting</b><small>Retail exterior prep, caulk, prime and paint planning allowance</small><a class="src" href="https://www.angi.com/articles/cost-paint-house-exterior/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">$3.00 / living sf</span></label>
<label class="repair"><input type="checkbox" data-name="Exterior siding / trim repairs" data-method="exterior"><span><b>Exterior repairs / Siding / Trim</b><small>Choose localized repairs or broader siding, fascia and trim work</small><a class="src" href="https://www.angi.com/articles/how-much-cost-repair-siding/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">Choose scope</span></label>
<div class="scope" data-for="Exterior siding / trim repairs"><select data-scope="Exterior siding / trim repairs"><option value="2500">Localized repairs</option><option value="6000" selected>Moderate repairs</option><option value="12000">Extensive siding / trim repairs</option></select></div>
<label class="repair"><input type="checkbox" data-name="Window replacement" data-method="windows"><span><b>Windows</b><small>Choose approximate number of standard replacement windows</small><a class="src" href="https://www.angi.com/articles/how-much-does-window-replacement-cost/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">Choose count</span></label>
<div class="scope" data-for="Window replacement"><select data-scope="Window replacement"><option value="3000">About 4 windows</option><option value="6000" selected>About 8 windows</option><option value="9000">About 12 windows</option></select></div>
<label class="repair"><input type="checkbox" data-name="Water / mold restoration" data-method="water"><span><b>Water / Mold Damage</b><small>Choose a planning scope for professional remediation/restoration</small><a class="src" href="https://www.angi.com/articles/how-much-does-it-cost-repair-water-damage/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">Choose scope</span></label>
<div class="scope" data-for="Water / mold restoration"><select data-scope="Water / mold restoration"><option value="2000">Localized / minor</option><option value="5000" selected>Moderate restoration</option><option value="12000">Extensive restoration</option></select></div>
<label class="repair"><input type="checkbox" data-name="Cleanout / debris" data-method="cleanout"><span><b>Cleanout / Debris Removal</b><small>Professional haul-away based on approximate volume</small><a class="src" href="https://www.angi.com/articles/how-much-does-junk-removal-cost/tx/houston" target="_blank" rel="noopener">Source: Angi Houston 2026 ↗</a></span><span class="range">Choose scope</span></label>
<div class="scope" data-for="Cleanout / debris"><select data-scope="Cleanout / debris"><option value="400">Light cleanout</option><option value="800" selected>Full truck / moderate</option><option value="1600">Heavy multi-load cleanout</option></select></div>
</div></div>
</section>
<aside class="rm-panel rm-result">
<div class="eyebrow">Estimated retail repairs</div><div class="total" id="total">$0</div>
<p class="rm-note" id="status">Select repairs to build your estimate. The condition setting adds a modest planning allowance for complexity and hidden work; it is not a substitute for bids.</p>
<div class="rm-breakdown" id="breakdown"><div class="rm-row"><span>No repairs selected yet.</span></div></div>
<div class="rm-cta"><p><strong>Before you spend that money, compare the as-is option.</strong><br/>CashAsIs can evaluate the property in its current condition. You do not need to complete these repairs for our purchase.</p><a class="rm-btn" href="https://www.cashasis.com?utm_source=repair_math&utm_medium=calculator&utm_campaign=fix_or_sell">See What CashAsIs Would Offer →</a></div>
<div class="privacy"><strong>How this estimate works:</strong> measurable work is calculated from retail installed unit pricing where appropriate. Room/system repairs use the scope you select. This is an educational planning estimate, not a contractor bid.</div>
</aside>
</div>
<section class="rm-panel sources">
<h2>Where these Houston retail ranges come from</h2>
<p class="rm-note">The calculator uses representative Houston-area repair estimates from current contractor and consumer cost data. Actual project costs can vary based on materials, scope, permits, access and property conditions.</p>
<ul>
<li><a href="https://www.angi.com/articles/how-much-does-roof-replacement-cost/tx/houston">Roof replacement — Angi Houston 2026</a></li>
<li><a href="https://www.angi.com/articles/insider-s-price-guide-new-heating-and-cooling-system/tx/houston">HVAC replacement — Angi Houston 2026</a></li>
<li><a href="https://htxfoundations.com/blog/how-much-foundation-repair-cost-houston/">Foundation repair — HTX Foundation Repair 2026</a></li>
<li><a href="https://skyprohouston.com/remodeling-cost-houston/">Kitchen and bathroom remodeling — Sky Pro Houston signed-contract ranges</a></li>
<li><a href="https://texasqualityplumbing.com/learning-center/repiping-house-cost-houston">Whole-home repipe — Texas Quality Plumbing 2026</a></li>
<li><a href="https://www.angi.com/articles/ask-angie-what-does-it-cost-upgrade-200-amps/tx/houston">Electrical panel — Angi Houston 2026</a></li>
<li><a href="https://houstonsuperiorpainting.com/houston-painting-cost-guide">Interior painting — Houston Superior Painting 2026</a></li><li><a href="https://www.angi.com/articles/how-much-should-my-new-floor-cost/tx/houston">Flooring — Angi Houston 2026</a></li><li><a href="https://www.angi.com/articles/cost-paint-house-exterior/tx/houston">Exterior painting — Angi Houston 2026</a></li><li><a href="https://www.angi.com/articles/how-much-cost-repair-siding/tx/houston">Exterior siding repairs — Angi Houston 2026</a></li><li><a href="https://www.angi.com/articles/how-much-does-window-replacement-cost/tx/houston">Windows — Angi Houston 2026</a></li><li><a href="https://www.angi.com/articles/how-much-does-it-cost-repair-water-damage/tx/houston">Water / mold restoration — Angi Houston 2026</a></li><li><a href="https://www.angi.com/articles/how-much-does-junk-removal-cost/tx/houston">Cleanout / debris removal — Angi Houston 2026</a></li>
</ul>
</section>
</main><Footer/>
<script is:inline>
(function(){
 const root=document, checks=[...root.querySelectorAll('#repairs input[type="checkbox"]')];
 const condition=root.querySelector('#condition'), sqft=root.querySelector('#sqft');
 const total=root.querySelector('#total'), breakdown=root.querySelector('#breakdown'), status=root.querySelector('#status');
 const money=n=>'$'+Math.round(n).toLocaleString('en-US');
 const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
 function scopeValue(name){const s=root.querySelector('[data-scope="'+name+'"]');return s?Number(s.value):0}
 function estimate(x,sf){
   const n=x.dataset.name, method=x.dataset.method;
   if(method==='sf'){
     let qty=sf;
     if(n==='Roof replacement') qty=sf*1.18;
     return qty*Number(x.dataset.rate);
   }
   if(method==='hvac') return scopeValue(n)
   if(method==='repipe') return 4200+(sf*3.1);
   if(method==='fixed') return Number(x.dataset.cost);
   if(method==='foundation'||method==='electrical'||method==='exterior'||method==='windows'||method==='water'||method==='cleanout') return scopeValue(n);
   if(method==='kitchen') return scopeValue(n);
   if(method==='bath') return Number(root.querySelector('#bathCount').value)*Number(root.querySelector('#bathScope').value);
   return 0;
 }
 function calc(){
   const sf=clamp(Number(sqft.value)||1800,400,10000), selected=checks.filter(x=>x.checked);
   const conditionMult=Number(condition.value)||1;
   const rows=selected.map(x=>({name:x.dataset.name,val:estimate(x,sf)*conditionMult}));
   const sum=rows.reduce((a,r)=>a+r.val,0);
   const est=Math.round(sum/100)*100;
   total.textContent=selected.length?money(est):'$0';
   breakdown.innerHTML=selected.length?rows.map(r=>'<div class="rm-row"><span>'+r.name+'</span><strong>'+money(Math.round(r.val/100)*100)+'</strong></div>').join(''):'<div class="rm-row"><span>No repairs selected yet.</span></div>';
   status.textContent=selected.length?'Estimated retail contractor cost for an approximately '+sf.toLocaleString('en-US')+' sq ft Houston-area property. Size-based work uses installed unit pricing; kitchens, bathrooms and foundation use the scope you selected.':'Enter the house size and select repairs to build one estimated retail contractor budget.';
 }
 checks.forEach(x=>x.addEventListener('change',function(){const box=root.querySelector('.scope[data-for="'+x.dataset.name+'"]');if(box)box.classList.toggle('show',x.checked);calc()}));
 root.querySelectorAll('.scope select').forEach(x=>x.addEventListener('change',calc));
 condition.addEventListener('change',calc);sqft.addEventListener('input',calc);
 root.querySelectorAll('input[name="updated"]').forEach(x=>x.addEventListener('change',calc));
 calc();
})();
</script>
<script is:inline src="https://link.msgsndr.com/js/external-tracking.js" data-tracking-id="tk_61336d42285a45a29bdc44b9a0947ddf"></script>
</body></html>